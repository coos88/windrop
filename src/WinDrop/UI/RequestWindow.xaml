<Window x:Class="WinDrop.UI.RequestWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AirDrop" Width="380" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" Topmost="True" ShowInTaskbar="False" ShowActivated="False"
        FontFamily="Segoe UI Variable Text, Segoe UI">
  <Border Margin="16" CornerRadius="14" Background="{DynamicResource CardBrush}"
          BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" Padding="16">
    <Border.Effect>
      <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.25" />
    </Border.Effect>
    <StackPanel>
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid Width="44" Height="44" VerticalAlignment="Top">
          <Ellipse x:Name="Bubble" />
          <TextBlock x:Name="InitialsText" Foreground="White" FontSize="20" FontWeight="SemiBold"
                     HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Grid>
        <StackPanel Grid.Column="1" Margin="12,0,0,0">
          <TextBlock Text="AirDrop" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource SubtleTextBrush}" />
          <TextBlock x:Name="TitleText" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap"
                     Foreground="{DynamicResource TextBrush}" Margin="0,2,0,0" />
          <TextBlock x:Name="FilesText" FontSize="12.5" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                     Foreground="{DynamicResource SubtleTextBrush}" Margin="0,4,0,0" MaxHeight="54" />
        </StackPanel>
      </Grid>
      <Grid Margin="0,14,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="10" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Button x:Name="DeclineButton" Content="Weigeren" Style="{StaticResource PillButton}" Click="Decline_Click" />
        <Button x:Name="AcceptButton" Grid.Column="2" Content="Accepteren" Style="{StaticResource AccentButton}" Click="Accept_Click" />
      </Grid>
    </StackPanel>
  </Border>
</Window>
