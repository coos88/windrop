<Window x:Class="WinDrop.UI.ShareWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AirDrop" Width="460" Height="330"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" Topmost="True" WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI Variable Text, Segoe UI">
  <Border Margin="16" CornerRadius="14" Background="{DynamicResource CardBrush}"
          BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
          MouseLeftButtonDown="Card_MouseDown">
    <Border.Effect>
      <DropShadowEffect BlurRadius="28" ShadowDepth="6" Opacity="0.3" />
    </Border.Effect>
    <Grid Margin="18,14,18,16">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <Grid>
        <StackPanel>
          <TextBlock Text="AirDrop" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" />
          <TextBlock x:Name="SubtitleText" FontSize="12.5" Foreground="{DynamicResource SubtleTextBrush}" Margin="0,2,0,0" />
        </StackPanel>
        <Button Content="Klaar" HorizontalAlignment="Right" VerticalAlignment="Top"
                Style="{StaticResource PillButton}" Padding="14,5" Click="Done_Click" />
      </Grid>

      <Grid Grid.Row="1" Margin="0,12,0,0">
        <WrapPanel x:Name="Peers" HorizontalAlignment="Center" VerticalAlignment="Center" />
        <StackPanel x:Name="SearchingPanel" HorizontalAlignment="Center" VerticalAlignment="Center">
          <TextBlock x:Name="SearchingText" Text="Zoeken naar apparaten…" FontSize="13"
                     Foreground="{DynamicResource SubtleTextBrush}" HorizontalAlignment="Center" />
          <ProgressBar IsIndeterminate="True" Width="140" Height="3" Margin="0,10,0,0"
                       Foreground="{DynamicResource AccentBrush}" Background="Transparent" BorderThickness="0" />
        </StackPanel>
      </Grid>

      <TextBlock Grid.Row="2" TextWrapping="Wrap" FontSize="11.5" Foreground="{DynamicResource SubtleTextBrush}"
                 TextAlignment="Center"
                 Text="Zie je je apparaat niet? Zet AirDrop daar op ‘Iedereen gedurende 10 minuten’." />
    </Grid>
  </Border>
</Window>
